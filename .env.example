# Local development defaults. Synthetic data only; do not reuse these values anywhere real.
# `make up` copies this file to .env on first run.

# Two Postgres instances (ADR 0011): the shop source database and the platform metadata database.
SHOP_POSTGRES_USER=shop
SHOP_POSTGRES_PASSWORD=shop
PLATFORM_POSTGRES_USER=platform
PLATFORM_POSTGRES_PASSWORD=platform

# Read-only role on the `analytics` database (marts served to Evidence, ADR 0018).
ANALYTICS_READER_PASSWORD=analytics-reader-dev

# Lakekeeper encrypts stored secrets (the warehouse's S3 key) with this key.
LAKEKEEPER_ENCRYPTION_KEY=dev-only-not-a-real-secret

# Garage: 32-byte hex secret for the RPC layer and a token for the admin API.
GARAGE_RPC_SECRET=7f1e2a9c4b8d6e0f3a5c7b9d1e2f4a6c8b0d2e4f6a8c0b1d3e5f7a9b1c3d5e7f
GARAGE_ADMIN_TOKEN=dev-admin-token

# S3 access key imported into Garage by `make storage-init` (format: GK + 24 hex / 64 hex).
S3_ACCESS_KEY_ID=GK0a1b2c3d4e5f60718293a4b5c
S3_SECRET_ACCESS_KEY=8f3c1a5e7b9d2f4a6c8e0b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1a
S3_BUCKET=lakehouse

# S3 endpoint as seen from inside the compose network (Lakekeeper) -- see ADR 0002/0012.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
